rules_version = '2';

// Regras do banco de dados do Landora.
//
// Proteção por lista de acesso (config/access → { emails: [...] }):
// - Enquanto a lista NÃO existe, qualquer pessoa logada acessa tudo (como era antes).
// - Depois que alguém ativa a proteção (Perfil → Acesso ao app), só os e-mails da lista
//   leem ou alteram qualquer dado. Contas de fora não veem nada.
// - Ninguém consegue tirar o próprio e-mail da lista (evita se trancar para fora).
//
// As funções da Vercel (notificações, lembretes) usam a conta de serviço e não passam por aqui.

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function accessPath() {
      return /databases/$(database)/documents/config/access;
    }
    function locked() {
      return exists(accessPath());
    }
    function myEmail() {
      return request.auth.token.email != null ? request.auth.token.email.lower() : "";
    }
    function isMember() {
      return signedIn() && (!locked() || myEmail() in get(accessPath()).data.emails);
    }

    // A lista de acesso.
    match /config/access {
      allow read: if isMember();
      // Ativar a proteção: só quando ainda não existe, e quem ativa precisa estar na lista.
      allow create: if signedIn() && !locked()
        && request.resource.data.emails is list
        && myEmail() in request.resource.data.emails;
      // Alterar: só quem está na lista, sem tirar a si mesmo.
      allow update: if isMember()
        && request.resource.data.emails is list
        && myEmail() in request.resource.data.emails;
      allow delete: if false;
    }

    // Economia/cassino (moedas de mentira). Todos veem as carteiras (ranking). Cada um cria só a
    // própria; alterações podem vir de outra pessoa (pagar, roubar, empréstimo, prêmio de mesa),
    // mas nenhum saldo pode ficar negativo. Apagar carteira: só o administrador (hoje ninguém: o
    // modo admin do Davi foi removido; para dar o poder a alguém, ponha o e-mail na lista abaixo).
    function isEconomyAdmin() {
      return myEmail() in [];
    }
    function validWallet() {
      return request.resource.data.balance is number && request.resource.data.balance >= 0
        && (!("bank" in request.resource.data) || (request.resource.data.bank is number && request.resource.data.bank >= 0));
    }
    match /wallets/{uid} {
      allow read: if isMember();
      allow create: if isMember() && request.auth.uid == uid && validWallet();
      allow update: if isMember() && validWallet();
      allow delete: if isMember() && isEconomyAdmin();
    }

    // Todo o resto do app. As coleções radar_* são do Radar de Prospecção e têm regras próprias abaixo.
    match /{collection}/{document=**} {
      allow read, write: if collection != "config" && collection != "wallets" && !collection.matches("radar_.*") && isMember();
    }

    // ===================== Radar de Prospecção (pasta radar-prospeccao/) =====================
    // Conta própria (e-mail e senha). Quem já usa o app Landora entra direto; os demais ficam
    // "aguardando aprovação" até um administrador do Radar aprovar. Administradores: radar_config/acesso → { admins: [e-mails] }.
    // O pipeline (GitHub Actions) usa a conta de serviço e não passa por estas regras.
    function radarAccessPath() {
      return /databases/$(database)/documents/radar_config/acesso;
    }
    function radarAdmin() {
      return signedIn() && exists(radarAccessPath()) && myEmail() in get(radarAccessPath()).data.admins;
    }
    function radarProfile() {
      return /databases/$(database)/documents/radar_perfis/$(request.auth.uid);
    }
    // Quem já usa o app Landora entra direto: precisa ter users/{uid} e estar na lista de acesso
    // do app (config/access). Com a lista desligada, ninguém entra direto (qualquer conta poderia
    // criar o próprio users/{uid}), e vale a aprovação manual.
    function landoraAppUser() {
      return locked() && isMember() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function radarBlocked() {
      return exists(radarProfile()) && get(radarProfile()).data.get("bloqueado", false) == true;
    }
    function radarMember() {
      return radarAdmin() || (signedIn() && !radarBlocked()
        && (landoraAppUser() || (exists(radarProfile()) && get(radarProfile()).data.aprovado == true)));
    }
    match /radar_config/acesso {
      allow read: if signedIn();
      // O primeiro administrador se cadastra sozinho enquanto o documento não existe.
      allow create: if signedIn() && request.resource.data.admins is list && myEmail() in request.resource.data.admins;
      allow update: if radarAdmin() && request.resource.data.admins is list && myEmail() in request.resource.data.admins;
      allow delete: if false;
    }
    match /radar_config/{docId} {
      allow read: if radarMember();
      allow write: if radarAdmin() && docId != "acesso";
    }
    match /radar_perfis/{uid} {
      allow read: if radarMember() || (signedIn() && request.auth.uid == uid);
      // Cada um cria o próprio perfil, sempre como não aprovado (ou aprovado, se for administrador).
      allow create: if signedIn() && request.auth.uid == uid
        && (request.resource.data.aprovado == false || radarAdmin() || landoraAppUser())
        && request.resource.data.get("bloqueado", false) == false
        && request.resource.data.papel in ["vendedor", "gestor"];
      // Cada um edita o próprio perfil, sem mudar aprovação nem papel; o administrador edita qualquer um.
      allow update: if radarAdmin() || (signedIn() && request.auth.uid == uid
        && request.resource.data.aprovado == resource.data.aprovado
        && request.resource.data.papel == resource.data.papel
        && request.resource.data.get("bloqueado", false) == resource.data.get("bloqueado", false));
      allow delete: if radarAdmin();
    }
    match /radar_base/{document=**} {
      allow read: if radarMember();
      allow write: if false;
    }
    match /radar_execucoes/{id} {
      allow read: if radarMember();
      allow write: if false;
    }
    match /radar_pedidos/{id} {
      allow read: if radarMember();
      allow create: if radarMember() && request.resource.data.status == "pendente" && request.resource.data.por == request.auth.uid;
      allow update, delete: if radarAdmin();
    }
    match /radar_funil/{id} {
      allow read, write: if radarMember();
    }
    match /radar_eventos/{id} {
      allow read: if radarMember();
      allow create: if radarMember() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if radarAdmin();
    }
    match /radar_metas/{id} {
      allow read, write: if radarMember();
    }
    match /radar_metaLogs/{id} {
      allow read: if radarMember();
      allow create: if radarMember() && request.resource.data.uid == request.auth.uid;
      allow delete: if radarAdmin();
    }
    match /radar_manuais/{id} {
      allow read, create, update: if radarMember();
      allow delete: if radarMember() && (resource.data.por == request.auth.uid || radarAdmin());
    }
    // radar_state e radar_verificacoes: só o pipeline (conta de serviço).
  }
}
